generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  sitesCreated         Site[]        @relation("SiteCreatedBy")
  sitesUpdated         Site[]        @relation("SiteUpdatedBy")
  turbinesCreated      Turbine[]     @relation("TurbineCreatedBy")
  turbinesUpdated      Turbine[]     @relation("TurbineUpdatedBy")
  documentsUploaded    Document[]    @relation("DocumentUploadedBy")
  documentsMarkedReady Document[]    @relation("DocumentReadyForAwpBy")
  documentsDeleted     Document[]    @relation("DocumentDeletedBy")
  issuesResolved       AuditIssue[]  @relation("AuditIssueResolvedBy")
  templatesCreated     AwpTemplate[] @relation("AwpTemplateCreatedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum TurbineStatus {
  WORKING
  IN_USE
  SUSPENDED
  NOT_OPERATIONAL
}

model Site {
  id                 String    @id @default(cuid())
  name               String    @unique
  portfolio          String?
  spv                String?
  oAndMProvider      String?
  numberOfTurbines   Int
  turbineMake        String?
  technology         String?
  totalCapacityMw    Decimal?  @db.Decimal(10, 2)
  commissioningDate  DateTime?
  operationalSince   DateTime?
  assetManager       String?
  turbineOem         String?
  turbineModel       String?
  turbineRating      Decimal?  @db.Decimal(10, 2)
  projectStatus      String?
  lifeExpectancy     Int?
  lifeExtension      Int?
  gridConnectionType String?
  dno                String?
  hubHeight          Decimal?  @db.Decimal(8, 2)
  rotorDiameter      Decimal?  @db.Decimal(8, 2)
  latitude           Decimal?  @db.Decimal(9, 6)
  longitude          Decimal?  @db.Decimal(9, 6)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdById String
  createdBy   User    @relation("SiteCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("SiteUpdatedBy", fields: [updatedById], references: [id])

  turbines  Turbine[]
  documents Document[]

  @@index([createdById])
  @@map("site")
}

model TurbineModel {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  turbines  Turbine[]
  templates AwpTemplate[]

  @@map("turbine_model")
}

model AwpTemplate {
  id             String @id @default(cuid())
  name           String
  sourcePdfS3Key String

  // Optional categorisation
  turbineModelId String?
  turbineModel   TurbineModel? @relation(fields: [turbineModelId], references: [id])
  jobType        String?

  createdById String
  createdBy   User   @relation("AwpTemplateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([turbineModelId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("awp_template")
}

model Turbine {
  id             String        @id @default(cuid())
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name           String
  turbineModelId String
  turbineModel   TurbineModel  @relation(fields: [turbineModelId], references: [id])
  serial         String?
  status         TurbineStatus @default(WORKING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdById String
  createdBy   User    @relation("TurbineCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("TurbineUpdatedBy", fields: [updatedById], references: [id])

  @@unique([siteId, name])
  @@index([siteId])
  @@index([turbineModelId])
  @@index([createdById])
  @@map("turbine")
}

enum DocType {
  AWP_SOURCE
  REPORT
  REFERENCE
  OTHER
}

model Document {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fileName   String
  sizeBytes  BigInt
  s3Key      String   @unique
  docType    DocType
  uploadedAt DateTime @default(now())

  uploadedById String
  uploadedBy   User   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  // AWP readiness
  markedReadyForAwpById String?
  markedReadyForAwpBy   User?     @relation("DocumentReadyForAwpBy", fields: [markedReadyForAwpById], references: [id])
  markedReadyForAwpAt   DateTime?
  markedReadyForAwpNote String?

  // Version chain — when user re-uploads a corrected version
  version           Int       @default(1)
  previousVersionId String?   @unique
  previousVersion   Document? @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  nextVersion       Document? @relation("DocumentVersions")

  // Soft delete
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("DocumentDeletedBy", fields: [deletedById], references: [id])

  audits Audit[]

  @@index([siteId])
  @@index([docType])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("document")
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AuditMode {
  STANDARD
  SUPER
}

enum IssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IssueStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Audit {
  id              String       @id @default(cuid())
  documentId      String
  document        Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  externalAuditId String?      @unique
  status          AuditStatus  @default(PENDING)
  mode            AuditMode    @default(SUPER)
  overallScore    Float?
  confidenceScore Float?
  issuesFound     Int          @default(0)
  reportJson      Json?
  errorMessage    String?
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  issues          AuditIssue[]

  @@index([documentId])
  @@map("audit")
}

model AuditIssue {
  id             String        @id @default(cuid())
  auditId        String
  audit          Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  severity       IssueSeverity
  issueType      String
  title          String
  description    String
  suggestion     String?
  pageNumber     Int?
  section        String?
  status         IssueStatus   @default(OPEN)
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?         @relation("AuditIssueResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?
  createdAt      DateTime      @default(now())

  @@index([auditId])
  @@map("audit_issue")
}
